{
  "theme": "sharp",
  "appearance": {
    "default": "system",
    "showToggle": true,
    "contentIcons": "accent"
  },
  "fonts": {
    "body": {
      "family": "Inter",
      "weight": ["400", "500", "600"]
    },
    "heading": {
      "family": "Inter",
      "weight": ["400", "500", "600"]
    }
  },
  "favicon": {
    "light": "/brand/cursor-light.svg",
    "dark": "/brand/cursor-dark.svg"
  },
  "markdown": { "enabled": true },
  "i18n": {
    "defaultLocale": "en",
    "locales": [{ "code": "en", "label": "English" }]
  },
  "navbar": {
    "logo": {
      "light": "/brand/cursor-light.svg",
      "dark": "/brand/cursor-dark.svg",
      "showTitle": true
    },
    "primary": { "label": "Get started", "href": "/quickstart" }
  },
  "tabs": [
    {
      "tab": "Cursor Guide",
      "groups": [
        {
          "group": "Start here",
          "icon": "book-open",
          "pages": ["introduction", "quickstart"]
        },
        {
          "group": "Practical guides",
          "icon": "wrench",
          "pages": ["guides/project-rules"]
        }
      ]
    }
  ]
}
